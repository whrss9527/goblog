app:
  name: 了迹奇有没
  version: true
  mode: debug
  addr: localhost:9091
  host: http://localhost:9091
  cdn: "/static"
  music: ""
  # 用 `openssl rand -hex 32` 生成一个随机串，不要直接使用此处占位值
  session_secret: "change-me-to-a-random-string"
  # 博客内容仓库会被 clone 到此目录（运行时拉取）
  data_dir: "/tmp/blog-data"
  # 公开仓库直接填 URL；私有仓库还需要在下方 git_token 填 PAT
  git_repo: "https://github.com/your-username/blog-data.git"
  # 仅当 git_repo 是私有仓库时填 GitHub PAT (Contents: Read)；公开仓留空
  git_token: ""
  # 站点一句话简介：用于首页 <title>、<meta name="description"> 与结构化数据；留空则只显示站点名
  description: ""
  # 文章 Markdown 在哪里渲染：server（默认，HTML 直出，首屏快、对 SEO 友好、无需 jQuery/editor.md）
  # 或 client（1.6 之前的方式，浏览器里用 editor.md 渲染）。含流程图/时序图/公式的文章始终回退为 client
  markdown_render: "server"
  # PWA：可安装到桌面 / 主屏，读过的文章断网也能看（Service Worker）。默认开启；
  # 改成 false 会同时让访客浏览器里已安装的 Service Worker 自动注销并清空缓存
  pwa: true
  # 后台账号（推荐写在这里）。两项都填了之后只认这里的账号，内容仓库里的 users.json 不再生效 ——
  # blog-data 如果是公开仓库，users.json 里的密码哈希任何人都能下载。
  # 哈希用 `./goblog -hash-password` 生成（从标准输入读密码）；YAML 里请保留引号。
  admin_email: ""
  admin_password_hash: ""
  # 项目页（/projects）：GitHub 仓库显示 Star、主要语言、最近提交，服务器每 6 小时读取一次公开数据（只在内存里）。
  # 默认开启；服务器连不上 GitHub 或不想让它访问外网时改成 false
  github_stats: true
  # 后台「GitHub 上最近的仓库」列谁的仓库；留空 = git_repo 的所有者（github.com/<用户名>/...）
  github_user: ""
  # 可选：GitHub API 不带 token 每小时 60 次，带 token 5000 次。任何 token 都行（不需要勾选权限）；不要提交真实值
  github_token: ""
  # 运行时多久和内容仓库的远程同步一次：拉取在电脑上 git push 的文章、推送服务器自己的提交。默认 "10m"，"off" 关闭定时同步
  # （后台「同步内容仓库」按钮和下面的 Webhook 照常可用）
  git_sync: "10m"
  # GitHub Webhook 的密钥（openssl rand -hex 20）：内容仓库 Settings → Webhooks，Payload URL 填 https://你的域名/api/hooks/git，
  # Content type 选 application/json，Secret 填这个值，只勾 push 事件。推送后几秒内同步；留空则不开放这个接口
  git_webhook_secret: ""
  # 编辑器里粘贴 / 拖入 / 选择的图片存到哪儿。不配置：内容仓库的 images/ 目录（随文章提交，站点以 /images/... 提供）。
  # 五项（s3_endpoint、s3_bucket、s3_access_key、s3_secret_key、public_url）都填上则直接传到 R2 / S3 兼容存储
  upload:
    s3_endpoint: ""        # R2：https://<账号 ID>.r2.cloudflarestorage.com
    s3_region: "auto"      # R2 固定 auto；AWS 写桶所在区域
    s3_bucket: ""
    s3_access_key: ""
    s3_secret_key: ""      # 不要提交真实值
    public_url: ""         # 桶的公开访问域名，例如 https://pic.example.com
    prefix: ""             # 可选：对象名前缀，例如 "blog/"
    max_mb: 10             # 单张图片上限

server:
  # 监听地址。留空 = 所有网卡；前面有 nginx / cloudflared（Cloudflare Tunnel）时建议写 "127.0.0.1"，
  # 这样源站端口不会绕过它们被直接访问到
  host: ""
  http_port: 9091
  graceful_shutdown_timeout: 15s
  # 可信的反向代理（IP 或网段）：只有它们转发的 X-Forwarded-For 会被当作访客 IP（登录 / 点赞 / 搜索按 IP 限流）。
  # 留空 = 只信任本机（cloudflared / nginx 和 goblog 在同一台机器上）；代理跑在 Docker 等别处时写它的地址，如 ["172.18.0.0/16"]
  trusted_proxies: []
