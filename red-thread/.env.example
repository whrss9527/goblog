# 复制为 .env.local（本地）或填到 Vercel / Docker 的环境变量里。
# 什么都不填也能在本地跑起来：数据库用内置的 PGlite，照片存在 .data/uploads。

# ---------------------------------------------------------------- 登录（必填）
# 随机长字符串，例如 `openssl rand -base64 32` 的输出
AUTH_SECRET=
# 你的账号（会显示为“我们 & 请柬”里的第一个名字）
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Ta 的账号（可选，两个人各用各的，上传的照片会记下是谁拍的）
PARTNER_EMAIL=
PARTNER_PASSWORD=

# ---------------------------------------------------------------- 网站
# 正式域名，用于分享链接、二维码和社交卡片，例如 love.example.com
NEXT_PUBLIC_DOMAIN=
# 纪念日、倒计时按哪个时区算（构建时写入，默认 Asia/Shanghai）
NEXT_PUBLIC_TIMEZONE=Asia/Shanghai

# ---------------------------------------------------------------- 数据库
# 不填则使用内置 PGlite（数据在 .data/pglite，适合本地和 Docker 单机）
# Vercel 上请用 Neon / Supabase / Vercel Marketplace 的 Postgres
POSTGRES_URL=
# 自建的 Postgres 没有开 SSL 时设为 1
# DISABLE_POSTGRES_SSL=1

# ---------------------------------------------------------------- 照片存储（选一种）
# 与 exif-photo-blog 相同的变量名。都不填则存到本地磁盘（.data/uploads）。
# 同时配置了多种时，用它指定：vercel-blob / cloudflare-r2 / aws-s3 / minio / s3-compatible / local
# NEXT_PUBLIC_STORAGE_PREFERENCE=

# Vercel Blob（在 Vercel 项目里创建 Blob Store 后自动注入）
# BLOB_READ_WRITE_TOKEN=

# Cloudflare R2
# NEXT_PUBLIC_CLOUDFLARE_R2_BUCKET=
# NEXT_PUBLIC_CLOUDFLARE_R2_ACCOUNT_ID=
# NEXT_PUBLIC_CLOUDFLARE_R2_PUBLIC_DOMAIN=img.example.com
# CLOUDFLARE_R2_ACCESS_KEY=
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=

# AWS S3
# NEXT_PUBLIC_AWS_S3_BUCKET=
# NEXT_PUBLIC_AWS_S3_REGION=
# AWS_S3_ACCESS_KEY=
# AWS_S3_SECRET_ACCESS_KEY=

# MinIO
# NEXT_PUBLIC_MINIO_BUCKET=
# NEXT_PUBLIC_MINIO_DOMAIN=
# NEXT_PUBLIC_MINIO_PORT=
# NEXT_PUBLIC_MINIO_DISABLE_SSL=1
# MINIO_ACCESS_KEY=
# MINIO_SECRET_ACCESS_KEY=

# 任意兼容 S3 的存储：阿里云 OSS、腾讯云 COS、七牛 Kodo……
# S3_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# S3_REGION=oss-cn-hangzhou
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_ACCESS_KEY=
# 公开读取用的地址（存储桶域名或 CDN 域名）；不填则所有图片都走临时签名链接
# S3_PUBLIC_BASE_URL=https://your-bucket.oss-cn-hangzhou.aliyuncs.com
# 需要 path-style 地址的服务设为 1
# S3_FORCE_PATH_STYLE=1

# 存储桶设为私有时设为 1：所有图片（包括公开照片）都用每天更新的签名链接读取
# STORAGE_SIGNED_URLS=1

# 本地磁盘存储的位置（默认 .data/uploads）
# LOCAL_STORAGE_DIR=
# PGlite 数据目录（默认 .data/pglite）
# PGLITE_DIR=
